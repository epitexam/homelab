# Server Configuration
MUMBLE_WELCOME_TEXT="Welcome to the Mumble server"
MUMBLE_MAX_USERS=50
MUMBLE_ALLOW_PING=true
MUMBLE_SEND_VERSION=false

# Security - Change this password immediately!
MUMBLE_SUPERUSER_PASSWORD=YourHighlySecurePassword

# System & Permissions
MUMBLE_PUID=1000
MUMBLE_PGID=1000
MUMBLE_VERBOSE=false

# Resource Management
MEM_LIMIT=512M
MEM_RESERVE=128M
